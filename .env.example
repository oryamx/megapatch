NEBIUS_API_KEY=paste-your-key-here
# Needed for Sandboxes. Find it at tokenfactory.nebius.com/project/api-keys
NEBIUS_PROJECT_ID=paste-your-project-id-here
# Optional: Tavily web search, used to back unverifiable findings with public evidence.
# Without it the pipeline still runs and skips that step.
TAVILY_API_KEY=paste-your-tavily-key-here
# Local only. Turns on the dashboard's "Analyze (local)" tab, which spends model and sandbox
# credits. Needs the two credentials above as well. Never set this on a public deployment.
# MEGAPATCH_ENABLE_INTERACTIVE=1
# Optional overrides (defaults are in llm.py):
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# PRICE_IN_PER_M=0.30
# PRICE_OUT_PER_M=0.90
